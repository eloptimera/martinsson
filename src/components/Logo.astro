---
import { site } from "../site.config";
interface Props {
  light?: boolean;
  class?: string;
}
const { light = false, class: className = "" } = Astro.props;
const img = site.images.logo;
---

{img ? (
  <img
    src={img.src}
    width={img.width}
    height={img.height}
    alt={site.company.name}
    class:list={["h-11 w-auto", className]}
  />
) : (
  <span
    class:list={[
      "inline-flex flex-col leading-[0.95] font-[family-name:var(--font-wordmark)] font-bold uppercase",
      light ? "text-white" : "text-brand",
      className,
    ]}
  >
    <span class="text-[1.75rem] tracking-[0.01em]" aria-hidden="true">
      {site.company.shortName}
    </span>
    <span class="text-[1.05rem] tracking-[0.02em]" aria-hidden="true">
      {site.company.tagline}
    </span>
    <span class="sr-only">{site.company.name}</span>
  </span>
)}
