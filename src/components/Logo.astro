---
import { site } from "../site.config";
interface Props {
  light?: boolean;
  class?: string;
}
const { light = false, class: className = "" } = Astro.props;
---

<span class:list={["inline-flex items-center gap-3", className]}>
  <span
    aria-hidden="true"
    class:list={[
      "relative grid size-11 shrink-0 place-items-center rounded-lg",
      light ? "bg-white text-brand" : "bg-brand text-white",
    ]}
  >
    <svg
      viewBox="0 0 24 24"
      class="size-6"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M3 9h10l7-4v10l-7-4H3z"></path>
      <path d="M6 13v6h3v-6"></path>
    </svg>
    <span class="absolute inset-x-2 bottom-0 h-[3px] bg-signal"></span>
  </span>
  <span class="flex flex-col leading-none" aria-hidden="true">
    <span
      class:list={[
        "font-display text-[1.7rem] font-bold tracking-[0.02em]",
        light ? "text-white" : "text-brand",
      ]}
    >
      {site.company.shortName}
    </span>
    <span
      class:list={[
        "mt-0.5 font-display text-[0.8rem] font-semibold tracking-[0.24em] uppercase",
        light ? "text-white/80" : "text-ink/70",
      ]}
    >
      {site.company.tagline}
    </span>
  </span>
  <span class="sr-only">{site.company.name}</span>
</span>
