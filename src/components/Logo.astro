---
import { site } from "../site.config";
interface Props {
  light?: boolean;
  class?: string;
}
const { light = false, class: className = "" } = Astro.props;
const img = site.images.logo;
---

{img ? (
  <img
    src={img.src}
    width={img.width}
    height={img.height}
    alt={site.company.name}
    class:list={["h-11 w-auto", className]}
  />
) : (
  <span class:list={["inline-flex flex-col leading-none", light ? "text-white" : "text-ink", className]}>
    <span
      class="font-[family-name:var(--font-serif)] text-[1.35rem] font-semibold tracking-[0.22em]"
      aria-hidden="true"
    >
      {site.company.shortName.toUpperCase()}
    </span>
    <span
      class:list={[
        "mt-1.5 text-[0.6rem] font-bold tracking-[0.32em]",
        light ? "text-white/80" : "text-brand",
      ]}
      aria-hidden="true"
    >
      {site.company.tagline.toUpperCase()}
    </span>
    <span class="sr-only">{site.company.name}</span>
  </span>
)}
