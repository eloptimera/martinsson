---
import { mark } from "../lib/text";

interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
}
const { eyebrow, title, intro } = Astro.props;
---

<section class="panel-brand relative isolate overflow-hidden">
  <div aria-hidden="true" class="stripes absolute inset-0 -z-10"></div>
  <div
    aria-hidden="true"
    class="absolute inset-y-0 right-0 -z-10 hidden w-1/3 skew-x-[-18deg] bg-brand-deep/40 lg:block"
  ></div>
  <div class="mx-auto max-w-[80rem] px-5 py-14 sm:px-8 sm:py-20">
    <p class="font-display text-base font-bold tracking-[0.18em] text-white/85 uppercase before:mr-3 before:inline-block before:h-[3px] before:w-6 before:bg-signal before:align-middle">
      {eyebrow}
    </p>
    <h1 class="mt-4 max-w-3xl text-[clamp(2.8rem,6.4vw,5.2rem)] leading-[1.06]" set:html={mark(title)} />
    {intro && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/90">{intro}</p>}
    <div class="mt-8 flex flex-wrap gap-3">
      <slot />
    </div>
  </div>
</section>
