---
import { mark } from "../lib/text";

interface Props {
  title: string;
  intro?: string;
}
const { title, intro } = Astro.props;
---

<div class="border-b border-line bg-tint">
  <div class="container-page py-10 sm:py-14">
    <h1 class="max-w-3xl text-4xl sm:text-5xl" set:html={mark(title)} />
    {intro && <p class="mt-4 max-w-2xl text-lg text-muted-foreground">{intro}</p>}
    <div class="mt-6 flex flex-wrap gap-3 empty:hidden">
      <slot />
    </div>
  </div>
</div>
