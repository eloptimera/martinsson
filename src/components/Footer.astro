---
import { site } from "../site.config";
import Logo from "./Logo.astro";

const c = site.company;
const link = "hover:underline";
const heading = "text-sm font-semibold tracking-wide text-white uppercase";
---

<footer class="mt-20 bg-brand-deep text-white">
  <div class="container-page grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr_1.2fr]">
    <div>
      <Logo light />
      <p class="mt-4 max-w-sm text-[0.95rem] text-white/80">
        Med över 60 års erfarenhet och kompetens i lackeringsbranschen. Billackering, underredsbehandling,
        plastreparationer och lackkonservering.
      </p>
    </div>

    <div>
      <p class={heading}>Tjänster</p>
      <ul class="mt-3 space-y-2 text-[0.95rem] text-white/85">
        {site.services.map((t) => (
          <li>
            <a href={`/${t.id}`} class={link}>
              {t.title}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <p class={heading}>Sidor</p>
      <ul class="mt-3 space-y-2 text-[0.95rem] text-white/85">
        {site.nav
          .filter((n) => n.href !== "/tjanster")
          .map((n) => (
            <li>
              <a href={n.href} class={link}>
                {n.label}
              </a>
            </li>
          ))}
        <li>
          <a href="/integritetspolicy" class={link}>
            Integritetspolicy
          </a>
        </li>
      </ul>
    </div>

    <div>
      <p class={heading}>Kontakt</p>
      <ul class="mt-3 space-y-2 text-[0.95rem] text-white/85">
        <li>
          <a href={`tel:${c.phoneLink}`} class={link}>
            {c.phone}
          </a>
        </li>
        <li>
          <a href={`mailto:${c.email}`} class={`${link} break-all`}>
            {c.email}
          </a>
        </li>
        {c.street && (
          <li>
            <address class="not-italic">
              {c.street}, {c.zip} {c.postalCity}
            </address>
          </li>
        )}
        <li class="pt-2 text-white/75">
          Mån–tors 07–17
          <br />
          Fredag 07–13
          <br />
          Lördag–söndag stängt
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/15">
    <div class="container-page flex flex-wrap justify-between gap-2 py-5 text-xs text-white/70">
      <span>
        © {new Date().getFullYear()} {c.name}
        {c.orgnr && ` · Org.nr ${c.orgnr}`}
      </span>
      {c.taxNote && <span>{c.taxNote}</span>}
    </div>
  </div>
</footer>
