---
import { site } from "../site.config";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";

const c = site.company;
const link =
  "rounded-sm underline decoration-transparent decoration-2 underline-offset-4 transition-colors duration-200 hover:decoration-signal";
const heading = "font-display text-lg font-bold tracking-[0.16em] text-white uppercase";
---

<footer class="panel-ink mt-20">
  <div class="mx-auto grid max-w-[80rem] gap-12 px-5 py-16 sm:px-8 md:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr_1.2fr]">
    <div>
      <Logo light />
      <p class="mt-5 max-w-sm text-sm leading-relaxed text-white/75">
        Med över 60 års erfarenhet och kompetens i lackeringsbranschen. Billackering, underredsbehandling,
        plastreparationer och lackkonservering.
      </p>
    </div>

    <div>
      <p class={heading}>Tjänster</p>
      <ul class="mt-4 space-y-2.5 text-sm text-white/85">
        {site.services.map((t) => (
          <li>
            <a href={`/tjanster#${t.id}`} class={link}>
              {t.title}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <p class={heading}>Sidor</p>
      <ul class="mt-4 space-y-2.5 text-sm text-white/85">
        {site.nav
          .filter((n) => n.href !== "/tjanster")
          .map((n) => (
            <li>
              <a href={n.href} class={link}>
                {n.label}
              </a>
            </li>
          ))}
        <li>
          <a href="/integritetspolicy" class={link}>
            Integritetspolicy
          </a>
        </li>
      </ul>
    </div>

    <div>
      <p class={heading}>Kontakt</p>
      <ul class="mt-4 space-y-3 text-sm text-white/85">
        <li class="flex gap-3">
          <Icon name="phone" class="mt-0.5 size-4 shrink-0 text-signal" />
          <a href={`tel:${c.phoneLink}`} class={link}>
            {c.phone}
          </a>
        </li>
        <li class="flex gap-3">
          <Icon name="mail" class="mt-0.5 size-4 shrink-0 text-signal" />
          <a href={`mailto:${c.email}`} class={link}>
            {c.email}
          </a>
        </li>
        {c.street && (
          <li class="flex gap-3">
            <Icon name="pin" class="mt-0.5 size-4 shrink-0 text-signal" />
            <address class="not-italic">
              {c.street}
              <br />
              {c.zip} {c.postalCity}
            </address>
          </li>
        )}
        <li class="flex gap-3">
          <Icon name="clock" class="mt-0.5 size-4 shrink-0 text-signal" />
          <span>
            Mån–tors 07–17
            <br />
            Fre 07–13
          </span>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/15">
    <div class="mx-auto flex max-w-[80rem] flex-wrap justify-between gap-2 px-5 py-6 text-xs text-white/70 sm:px-8">
      <span>
        © {new Date().getFullYear()} {c.name}
        {c.orgnr && ` · Org.nr ${c.orgnr}`}
      </span>
      {c.taxNote && <span>{c.taxNote}</span>}
    </div>
  </div>
</footer>
