---
/**
 * Hero-bilden: en svävande gräsö. Som standard används den genererade illustrationen
 * (/hero-island.svg, se src/lib/garden-island.ts). Sätt `heroImage` i src/site.config.ts
 * för att i stället visa ett riktigt foto eller en 3D-render.
 * Rent dekorativ (alt är tomt). Storlek och placering styrs med class.
 */
import { site } from "../site.config";

interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;

const custom = site.heroImage;
const src = custom?.src ?? "/hero-island.svg";
const width = custom?.width ?? 900;
const height = custom?.height ?? 740;
---

<div aria-hidden="true" class:list={["pointer-events-none", className]}>
  <div class="float-slow">
    <img
      src={src}
      srcset={custom?.srcset}
      sizes={custom?.srcset ? "(min-width: 1024px) 50vw, 92vw" : undefined}
      width={width}
      height={height}
      alt=""
      decoding="async"
      fetchpriority="high"
      class="block h-auto w-full select-none"
    />
  </div>
</div>
