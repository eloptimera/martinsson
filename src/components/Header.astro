---
import { site } from "../site.config";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";

const c = site.company;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isServicePage = site.services.some((s) => path === `/${s.id}`);
const isActive = (href: string) =>
  href === "/" ? path === "/" : href === "/tjanster" ? path === href || isServicePage : path === href;
const link = "px-3 py-3 text-[0.95rem] font-medium whitespace-nowrap text-ink/80 hover:text-brand";
const linkActive = "!text-brand font-semibold underline decoration-2 underline-offset-[10px]";
---

<header class="border-b border-line bg-white">
  <a
    href="#innehall"
    class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-4 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2 focus:font-semibold focus:text-ink focus:shadow-lg"
  >
    Hoppa till innehållet
  </a>

  <div class="bg-brand text-[0.85rem] text-white">
    <div class="container-page flex flex-wrap items-center justify-between gap-x-6 gap-y-1 py-2">
      <p class="flex flex-wrap items-center gap-x-5 gap-y-1">
        <a href={`tel:${c.phoneLink}`} class="inline-flex items-center gap-1.5 font-semibold hover:underline">
          <Icon name="phone" class="size-3.5" />
          {c.phone}
        </a>
        <a href={`mailto:${c.email}`} class="hidden items-center gap-1.5 hover:underline sm:inline-flex">
          <Icon name="mail" class="size-3.5" />
          {c.email}
        </a>
      </p>
      <p class="hidden text-white/90 md:block">Mån–tors 07–17 · Fre 07–13</p>
    </div>
  </div>

  <div class="container-page flex h-[4.5rem] items-center justify-between gap-6">
    <a href="/" aria-label={`${c.name} – startsida`} class="shrink-0">
      <Logo />
    </a>

    <nav class="hidden items-center lg:flex" aria-label="Huvudmeny">
      {site.nav.map((l) => (
        <a
          href={l.href}
          class:list={[link, isActive(l.href) && linkActive]}
          aria-current={isActive(l.href) ? "page" : undefined}
        >
          {l.label}
        </a>
      ))}
      <a href={site.navCta.href} class="btn-base btn-brand ml-4 min-h-10 px-4 py-2 text-[0.95rem]">
        {site.navCta.label}
      </a>
    </nav>

    <button
      type="button"
      data-menu-button
      aria-label="Öppna meny"
      aria-expanded="false"
      aria-controls="mobilmeny"
      class="group grid size-12 place-items-center rounded border border-line text-ink lg:hidden"
    >
      <Icon name="menu" class="size-6 group-aria-expanded:hidden" />
      <Icon name="x" class="hidden size-6 group-aria-expanded:block" />
    </button>
  </div>

  <nav id="mobilmeny" hidden aria-label="Mobilmeny" class="border-t border-line bg-white lg:hidden">
    <div class="container-page flex flex-col py-2">
      {site.nav.map((l) => (
        <a
          href={l.href}
          class:list={[
            "border-b border-line py-3.5 text-lg font-medium text-ink last:border-0",
            isActive(l.href) && "!text-brand font-semibold",
          ]}
          aria-current={isActive(l.href) ? "page" : undefined}
        >
          {l.label}
        </a>
      ))}
      <a href={site.navCta.href} class="btn-base btn-brand my-3">
        {site.navCta.label}
      </a>
    </div>
  </nav>
</header>
