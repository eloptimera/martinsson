---
import { site } from "../site.config";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
const link =
  "px-4 py-3 text-[0.95rem] font-medium whitespace-nowrap text-ink/75 transition-colors duration-200 hover:text-ink";
const linkActive = "!text-ink font-bold underline decoration-leaf decoration-2 underline-offset-[10px]";
---

<header class="relative z-20">
  <a
    href="#innehall"
    class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-4 focus:z-50 focus:rounded-full focus:bg-white focus:px-4 focus:py-2 focus:font-bold focus:text-ink focus:shadow-lg"
  >
    Hoppa till innehållet
  </a>
  <div class="flex h-[5rem] items-center justify-between gap-6 px-6 sm:px-10">
    <a href="/" aria-label={`${site.company.name} – startsida`} class="shrink-0">
      <Logo />
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Huvudmeny">
      {site.nav.map((l) => (
        <a
          href={l.href}
          class:list={[link, isActive(l.href) && linkActive]}
          aria-current={isActive(l.href) ? "page" : undefined}
        >
          {l.label}
        </a>
      ))}
    </nav>

    <a href={site.navCta.href} class="btn-base btn-brand hidden min-h-11 px-6 py-2 text-sm md:inline-flex">
      <Icon name="leaf" class="size-4" />
      {site.navCta.label}
    </a>

    <button
      type="button"
      data-menu-button
      aria-label="Öppna meny"
      aria-expanded="false"
      aria-controls="mobilmeny"
      class="group grid size-12 place-items-center rounded-full bg-tint text-ink md:hidden"
    >
      <Icon name="menu" class="size-5 group-aria-expanded:hidden" />
      <Icon name="x" class="hidden size-5 group-aria-expanded:block" />
    </button>
  </div>

  <nav
    id="mobilmeny"
    hidden
    aria-label="Mobilmeny"
    class="absolute inset-x-3 top-full z-30 flex flex-col gap-1 rounded-[1.5rem] bg-white p-3 shadow-xl shadow-ink/20 ring-1 ring-line md:hidden"
  >
    {site.nav.map((l) => (
      <a
        href={l.href}
        class:list={[link, "py-3.5 text-base", isActive(l.href) && linkActive]}
        aria-current={isActive(l.href) ? "page" : undefined}
      >
        {l.label}
      </a>
    ))}
    <a href={site.navCta.href} class="btn-base btn-brand mt-1">
      {site.navCta.label}
    </a>
  </nav>
</header>
