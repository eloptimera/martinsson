---
import { site } from "../site.config";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";

const c = site.company;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isServicePage = site.services.some((s) => path === `/${s.id}`);
const isActive = (href: string) =>
  href === "/" ? path === "/" : href === "/tjanster" ? path === href || isServicePage : path === href;
const link = "caps px-3 py-3 !tracking-[0.15em] whitespace-nowrap text-ink/75 hover:text-brand";
const linkActive = "!text-ink underline decoration-brand decoration-2 underline-offset-[10px]";
---

<header class="relative z-30">
  <a
    href="#innehall"
    class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-4 focus:z-50 focus:rounded-full focus:bg-white focus:px-4 focus:py-2 focus:font-semibold focus:text-ink focus:shadow-lg"
  >
    Hoppa till innehållet
  </a>

  <div class="mx-auto flex h-[5.25rem] max-w-[88rem] items-center justify-between gap-6 px-5 sm:px-10">
    <a href="/" aria-label={`${c.name} – startsida`} class="shrink-0">
      <Logo />
    </a>

    <nav class="hidden items-center lg:flex" aria-label="Huvudmeny">
      {site.nav.map((l) => (
        <a
          href={l.href}
          class:list={[link, isActive(l.href) && linkActive]}
          aria-current={isActive(l.href) ? "page" : undefined}
        >
          {l.label}
        </a>
      ))}
      <a
        href={`tel:${c.phoneLink}`}
        class="ml-4 hidden items-center gap-2 text-[0.95rem] font-bold text-ink hover:text-brand xl:inline-flex"
      >
        <Icon name="phone" class="size-4" />
        {c.phone}
      </a>
      <a href={site.navCta.href} class="btn-base btn-brand ml-4 min-h-11 px-5 py-2 text-[0.95rem]">
        {site.navCta.label}
      </a>
    </nav>

    <button
      type="button"
      data-menu-button
      aria-label="Öppna meny"
      aria-expanded="false"
      aria-controls="mobilmeny"
      class="group grid size-12 place-items-center rounded-full border border-line bg-white/60 text-ink lg:hidden"
    >
      <Icon name="menu" class="size-6 group-aria-expanded:hidden" />
      <Icon name="x" class="hidden size-6 group-aria-expanded:block" />
    </button>
  </div>

  <nav
    id="mobilmeny"
    hidden
    aria-label="Mobilmeny"
    class="absolute inset-x-3 top-full rounded-2xl bg-white p-3 shadow-xl ring-1 ring-line lg:hidden"
  >
    <div class="flex flex-col">
      {site.nav.map((l) => (
        <a
          href={l.href}
          class:list={[
            "caps border-b border-line px-3 py-4 text-ink last:border-0",
            isActive(l.href) && "!text-brand",
          ]}
          aria-current={isActive(l.href) ? "page" : undefined}
        >
          {l.label}
        </a>
      ))}
      <a href={`tel:${c.phoneLink}`} class="btn-base btn-outline mt-3">
        <Icon name="phone" class="size-4" />
        {c.phone}
      </a>
      <a href={site.navCta.href} class="btn-base btn-brand mt-2">
        {site.navCta.label}
      </a>
    </div>
  </nav>
</header>
