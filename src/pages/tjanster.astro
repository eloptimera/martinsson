---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Photo from "../components/Photo.astro";
import { site } from "../site.config";

const p = site.servicesPage;
---

<Base title={site.seo.services.title} description={site.seo.services.description}>
  <PageHero title={p.title} intro={p.intro} />

  <div class="container-page py-12 sm:py-16">
    <ul class="divide-y divide-line border-y border-line">
      {site.services.map((t) => (
        <li class="grid gap-4 py-8 sm:grid-cols-[1fr_2fr] sm:gap-10">
          <div>
            <h2 class="text-2xl">
              <a href={`/${t.id}`} class="text-brand hover:underline">
                {t.title}
              </a>
            </h2>
            <Photo
              img={site.images.services[t.id as keyof typeof site.images.services] ?? null}
              class="mt-4 aspect-[4/3] rounded"
            />
          </div>
          <div>
            <p class="text-lg">{t.intro}</p>
            <p class="mt-3 text-muted-foreground">{t.short}</p>
            <a href={`/${t.id}`} class="mt-4 inline-block font-semibold text-brand hover:underline">
              Läs mer om {t.title.toLowerCase()}
            </a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</Base>
