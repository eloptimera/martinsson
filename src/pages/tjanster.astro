---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import { site } from "../site.config";

const p = site.servicesPage;
---

<Base title={site.seo.services.title} description={site.seo.services.description}>
  <PageHero slot="hero" eyebrow={p.eyebrow} title={p.title} intro={p.intro}>
    <a href={site.navCta.href} class="btn-base btn-brand">
      {site.navCta.label}
    </a>
    <a href="/kontakt" class="btn-base btn-outline">
      Kontakta oss
    </a>
  </PageHero>

  <div class="container-page grid gap-5 py-20 sm:py-28">
    {site.services.map((t, i) => (
      <div class="reveal">
        <section
          id={t.id}
          aria-labelledby={`${t.id}-rubrik`}
          class:list={[
            "grid gap-8 rounded-[1.75rem] p-7 sm:p-12 lg:grid-cols-[1fr_1fr] lg:items-center lg:gap-16",
            i % 2 === 0 ? "bg-tint" : "bg-white ring-1 ring-line",
          ]}
        >
          <div>
            <span class="grid size-16 place-items-center rounded-2xl bg-brand text-white">
              <Icon name={t.icon} class="size-7" />
            </span>
            <h2 id={`${t.id}-rubrik`} class="mt-6 text-4xl sm:text-5xl">
              {t.title}
            </h2>
            <p class="mt-4 max-w-md text-lg leading-relaxed text-muted-foreground">{t.short}</p>
          </div>
          <div>
            <ul class="space-y-3">
              {t.points.map((point) => (
                <li class="flex gap-3 rounded-2xl bg-white p-4 text-ink shadow-sm shadow-brand/10">
                  <Icon name="check" class="mt-0.5 size-5 shrink-0 text-brand" strokeWidth={3} />
                  <span>{point}</span>
                </li>
              ))}
            </ul>
            <a href={site.navCta.href} class="btn-base btn-brand mt-6">
              {p.quoteLabel(t.title)}
            </a>
          </div>
        </section>
      </div>
    ))}
  </div>
</Base>
