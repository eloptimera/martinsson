---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import { site } from "../site.config";

const c = site.company;
const p = site.contactPage;
const card = "flex gap-4 rounded-xl bg-steel p-6";
const icon = "mt-1 size-6 shrink-0 text-brand";
const label = "text-sm font-bold text-ink";
const chip =
  "flex min-h-11 cursor-pointer items-center rounded-lg border-2 border-line px-4 py-2 text-sm font-bold transition-colors duration-200 hover:border-brand has-[:checked]:border-brand has-[:checked]:bg-brand has-[:checked]:text-white has-[:focus-visible]:outline-3 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-brand-bright";
---

<Base title={site.seo.contact.title} description={site.seo.contact.description}>
  <PageHero eyebrow={p.eyebrow} title={p.title} intro={p.intro} />

  {site.notice && (
    <div class="mx-auto mt-10 max-w-[80rem] px-5 sm:px-8">
      <p role="note" class="flex gap-4 rounded-xl border-l-4 border-signal bg-steel p-5 text-ink">
        <Icon name="badge" class="mt-0.5 size-6 shrink-0 text-brand" />
        <span class="leading-relaxed">{site.notice}</span>
      </p>
    </div>
  )}

  <section class="mx-auto grid max-w-[80rem] gap-12 px-5 py-12 sm:px-8 sm:py-20 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
    <div class="reveal space-y-4">
      <div class={card}>
        <Icon name="phone" class={icon} />
        <div>
          <p class="eyebrow">Telefon</p>
          <a
            href={`tel:${c.phoneLink}`}
            class="mt-1 block font-display text-5xl font-bold tracking-wide text-brand hover:text-brand-deep"
          >
            {c.phone}
          </a>
        </div>
      </div>
      <div class={card}>
        <Icon name="mail" class={icon} />
        <div class="min-w-0">
          <p class="eyebrow">E-post</p>
          <a href={`mailto:${c.email}`} class="mt-1 block font-bold break-all text-ink hover:text-brand">
            {c.email}
          </a>
        </div>
      </div>
      {c.street && (
        <div class={card}>
          <Icon name="pin" class={icon} />
          <div>
            <p class="eyebrow">Adress</p>
            <address class="mt-1 font-bold text-ink not-italic">
              {c.name}
              <br />
              {c.street}
              <br />
              {c.zip} {c.postalCity}
            </address>
          </div>
        </div>
      )}
      <div class={card}>
        <Icon name="clock" class={icon} />
        <div class="w-full">
          <p class="eyebrow">Öppettider</p>
          <dl class="mt-3 text-[0.95rem]">
            {c.hours.map((o) => (
              <div class="flex justify-between gap-6 border-b border-line py-2 last:border-0">
                <dt class="font-bold text-ink">{o.days}</dt>
                <dd class="tabular-nums text-muted-foreground">{o.time}</dd>
              </div>
            ))}
          </dl>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{c.hoursNote}</p>
        </div>
      </div>
    </div>

    <div class="reveal" style="--d:100ms">
      <form
        data-form="kontakt"
        class="grid gap-5 rounded-xl bg-white p-7 shadow-xl shadow-brand/10 ring-1 ring-line sm:p-10"
      >
        <h2 class="text-5xl">{p.formTitle}</h2>

        <fieldset>
          <legend class={label}>{p.customerLabel}</legend>
          <div class="mt-2 flex flex-wrap gap-2">
            {p.customerTypes.map((t, i) => (
              <label class={chip}>
                <input type="radio" name="kundtyp" value={t} checked={i === 0} class="sr-only" />
                {t}
              </label>
            ))}
          </div>
        </fieldset>

        <div class="grid gap-5 sm:grid-cols-2">
          <div class="sm:col-span-2">
            <label for="k-namn" class={label}>
              Namn / företag
            </label>
            <input id="k-namn" name="namn" autocomplete="name" required class="field mt-2" />
          </div>
          <div>
            <label for="k-epost" class={label}>
              E-post
            </label>
            <input id="k-epost" name="epost" type="email" autocomplete="email" required class="field mt-2" />
          </div>
          <div>
            <label for="k-telefon" class={label}>
              Telefon
            </label>
            <input id="k-telefon" name="telefon" type="tel" autocomplete="tel" required class="field mt-2" />
          </div>
          <div>
            <label for="k-tjanst" class={label}>
              {p.serviceLabel}
            </label>
            <select id="k-tjanst" name="tjanst" required class="field mt-2">
              <option value="" disabled selected>
                {p.servicePlaceholder}
              </option>
              {site.services.map((t) => (
                <option value={t.title}>{t.title}</option>
              ))}
              <option value={p.otherService}>{p.otherService}</option>
            </select>
          </div>
          <div>
            <label for="k-regnr" class={label}>
              Registreringsnummer <span class="font-normal text-muted-foreground">(valfritt)</span>
            </label>
            <input id="k-regnr" name="regnr" autocomplete="off" maxlength="8" class="field mt-2 uppercase" />
          </div>
        </div>
        <div>
          <label for="k-meddelande" class={label}>
            {p.messageLabel}
          </label>
          <textarea
            id="k-meddelande"
            name="meddelande"
            rows="5"
            required
            class="field mt-2"
            placeholder={p.messagePlaceholder}
          ></textarea>
        </div>

        <label class="flex items-start gap-3 text-sm text-muted-foreground">
          <input
            type="checkbox"
            name="gdpr_samtycke"
            value="ja"
            required
            class="mt-0.5 size-5 shrink-0 accent-brand"
          />
          <span>
            Jag samtycker till att {c.name} lagrar mina uppgifter för att kunna besvara min förfrågan. Läs mer
            i
            <a href="/integritetspolicy" class="font-bold text-brand underline">
              {" "}
              integritetspolicyn
            </a>
            .
          </span>
        </label>

        <!-- Honeypot: dolt för människor, bottar fyller i det -->
        <div class="sr-only" aria-hidden="true">
          <label for="k-website">Lämna tomt</label>
          <input id="k-website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <p data-form-status role="alert" hidden class="text-sm font-bold text-destructive"></p>
        <div>
          <button type="submit" data-submit class="btn-base btn-brand px-8">
            Skicka förfrågan
          </button>
        </div>
      </form>

      <div
        data-form-success="kontakt"
        hidden
        tabindex="-1"
        role="status"
        class="rounded-xl bg-white p-8 shadow-xl shadow-brand/10 ring-1 ring-line sm:p-10"
      >
        <span class="grid size-12 place-items-center rounded-full bg-brand text-white">
          <Icon name="check" class="size-6" strokeWidth={3} />
        </span>
        <h2 class="mt-5 text-5xl">{p.thanksTitle}</h2>
        <p class="mt-4 text-muted-foreground">{p.thanksText}</p>
        <a href="/" class="btn-base btn-outline mt-8">
          Tillbaka till startsidan
        </a>
      </div>
    </div>
  </section>
</Base>
