---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import { site } from "../site.config";

const c = site.company;
const p = site.contactPage;
const label = "block text-sm font-semibold";
const chip =
  "flex min-h-11 cursor-pointer items-center rounded border border-[#aeb6c6] px-4 py-2 text-[0.95rem] font-medium hover:border-brand has-[:checked]:border-brand has-[:checked]:bg-brand has-[:checked]:text-white has-[:focus-visible]:outline-3 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-[#6f86ff]";
---

<Base title={site.seo.contact.title} description={site.seo.contact.description}>
  <PageHero title={p.title} intro={p.intro} />

  <div class="container-page py-10 sm:py-14">
    {site.notice && (
      <p role="note" class="mb-10 rounded border border-line border-l-4 border-l-brand bg-tint p-5">
        {site.notice}
      </p>
    )}

    <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div class="space-y-8">
        <section>
          <h2 class="text-xl">Telefon</h2>
          <a
            href={`tel:${c.phoneLink}`}
            class="mt-1 block text-4xl font-bold tracking-tight text-brand hover:text-brand-deep"
          >
            {c.phone}
          </a>
        </section>
        <section>
          <h2 class="text-xl">E-post</h2>
          <a href={`mailto:${c.email}`} class="mt-1 inline-block break-all underline">
            {c.email}
          </a>
        </section>
        {c.street && (
          <section>
            <h2 class="text-xl">Adress</h2>
            <address class="mt-1 not-italic">
              {c.name}
              <br />
              {c.street}
              <br />
              {c.zip} {c.postalCity}
            </address>
          </section>
        )}
        <section>
          <h2 class="text-xl">Öppettider</h2>
          <dl class="mt-2 max-w-sm">
            {c.hours.map((o) => (
              <div class="flex justify-between gap-6 border-b border-line py-2 last:border-0">
                <dt class="font-medium">{o.days}</dt>
                <dd class="tabular-nums text-muted-foreground">{o.time}</dd>
              </div>
            ))}
          </dl>
          <p class="mt-3 text-sm text-muted-foreground">{c.hoursNote}</p>
          <p data-open-status class="mt-3 inline-flex items-center gap-2 text-sm font-semibold" hidden></p>
        </section>
      </div>

      <div>
        <form data-form="kontakt" class="grid gap-5 rounded-md border border-line p-6 sm:p-8">
          <h2 class="text-2xl">{p.formTitle}</h2>

          <fieldset>
            <legend class={label}>{p.customerLabel}</legend>
            <div class="mt-2 flex flex-wrap gap-2">
              {p.customerTypes.map((t, i) => (
                <label class={chip}>
                  <input type="radio" name="kundtyp" value={t} checked={i === 0} class="sr-only" />
                  {t}
                </label>
              ))}
            </div>
          </fieldset>

          <div class="grid gap-5 sm:grid-cols-2">
            <div class="sm:col-span-2">
              <label for="k-namn" class={label}>
                Namn / företag
              </label>
              <input id="k-namn" name="namn" autocomplete="name" required class="field mt-1.5" />
            </div>
            <div>
              <label for="k-epost" class={label}>
                E-post
              </label>
              <input
                id="k-epost"
                name="epost"
                type="email"
                autocomplete="email"
                required
                class="field mt-1.5"
              />
            </div>
            <div>
              <label for="k-telefon" class={label}>
                Telefon
              </label>
              <input
                id="k-telefon"
                name="telefon"
                type="tel"
                autocomplete="tel"
                required
                class="field mt-1.5"
              />
            </div>
            <div>
              <label for="k-tjanst" class={label}>
                {p.serviceLabel}
              </label>
              <select id="k-tjanst" name="tjanst" required class="field mt-1.5">
                <option value="" disabled selected>
                  {p.servicePlaceholder}
                </option>
                {site.services.map((t) => (
                  <option value={t.title}>{t.title}</option>
                ))}
                <option value={p.otherService}>{p.otherService}</option>
              </select>
            </div>
            <div>
              <label for="k-regnr" class={label}>
                Registreringsnummer <span class="font-normal text-muted-foreground">(valfritt)</span>
              </label>
              <input
                id="k-regnr"
                name="regnr"
                autocomplete="off"
                maxlength="8"
                class="field mt-1.5 uppercase"
              />
            </div>
          </div>
          <div>
            <label for="k-meddelande" class={label}>
              {p.messageLabel}
            </label>
            <textarea
              id="k-meddelande"
              name="meddelande"
              rows="5"
              required
              class="field mt-1.5"
              placeholder={p.messagePlaceholder}
            ></textarea>
          </div>

          <label class="flex items-start gap-3 text-sm text-muted-foreground">
            <input
              type="checkbox"
              name="gdpr_samtycke"
              value="ja"
              required
              class="mt-0.5 size-5 shrink-0 accent-brand"
            />
            <span>
              Jag samtycker till att {c.name} lagrar mina uppgifter för att kunna besvara min förfrågan. Läs
              mer i
              <a href="/integritetspolicy" class="font-semibold text-brand underline">
                {" "}
                integritetspolicyn
              </a>
              .
            </span>
          </label>

          <!-- Honeypot: dolt för människor, bottar fyller i det -->
          <div class="sr-only" aria-hidden="true">
            <label for="k-website">Lämna tomt</label>
            <input id="k-website" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <p data-form-status role="alert" hidden class="text-sm font-semibold text-destructive"></p>
          <div>
            <button type="submit" data-submit class="btn-base btn-brand px-8">
              Skicka förfrågan
            </button>
          </div>
        </form>

        <div
          data-form-success="kontakt"
          hidden
          tabindex="-1"
          role="status"
          class="rounded-md border border-line p-6 sm:p-8"
        >
          <span class="grid size-10 place-items-center rounded-full bg-brand text-white">
            <Icon name="check" class="size-5" strokeWidth={3} />
          </span>
          <h2 class="mt-4 text-2xl">{p.thanksTitle}</h2>
          <p class="mt-3 text-muted-foreground">{p.thanksText}</p>
          <a href="/" class="btn-base btn-outline mt-6">
            Tillbaka till startsidan
          </a>
        </div>
      </div>
    </div>
  </div>
</Base>
