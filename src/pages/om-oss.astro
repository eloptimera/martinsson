---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import { site } from "../site.config";
import { initials, mark } from "../lib/text";

const c = site.company;
const p = site.aboutPage;
const facts = [
  { label: "Företag", value: c.name },
  { label: "Organisationsnummer", value: c.orgnr },
  { label: "Verksamma sedan", value: String(c.founded) },
  ...p.facts,
  { label: "Adress", value: `${c.street}, ${c.zip} ${c.postalCity}` },
];
---

<Base title={site.seo.about.title} description={site.seo.about.description}>
  <PageHero slot="hero" eyebrow={p.eyebrow} title={p.title} intro={p.intro} />

  <section class="container-page pt-4">
    <p class="reveal max-w-2xl text-xl leading-relaxed text-ink/85">{p.body}</p>
  </section>

  <section class="container-page grid gap-4 py-16 sm:py-24 md:grid-cols-3">
    {p.values.map((v, i) => (
      <div class="reveal" style={`--d:${i * 90}ms`}>
        <article class:list={["h-full rounded-[1.75rem] p-8", v.style]}>
          <span class="grid size-14 place-items-center rounded-2xl bg-white/20">
            <Icon name={v.icon} class="size-6" />
          </span>
          <h2 class="mt-8 text-4xl">{v.title}</h2>
          <p class="mt-3 leading-relaxed opacity-90">{v.text}</p>
        </article>
      </div>
    ))}
  </section>

  <section class="bg-fade-tint py-20 sm:py-28">
    <div class="container-page grid gap-12 lg:grid-cols-2 lg:gap-20">
      <div class="reveal">
        <p class="eyebrow">{p.teamEyebrow}</p>
        <h2 class="mt-4 text-5xl sm:text-6xl" set:html={mark(p.teamHeading)} />
        <ul class="mt-8 space-y-3">
          {c.people.map((person) => (
            <li class="flex items-center gap-4 rounded-3xl bg-white p-4">
              <span
                aria-hidden="true"
                class="grid size-14 shrink-0 place-items-center rounded-full bg-brand font-display text-xl text-white"
              >
                {initials(person.name)}
              </span>
              <span>
                <span class="block font-bold text-ink">{person.name}</span>
                <span class="text-sm text-muted-foreground">{person.role}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>
      <div class="reveal" style="--d:100ms">
        <p class="eyebrow">{p.factsEyebrow}</p>
        <dl class="mt-6 divide-y-2 divide-line rounded-[2rem] bg-white px-6 py-2 sm:px-8">
          {facts.map((f) => (
            <div class="grid gap-1 py-4 sm:grid-cols-[11rem_1fr] sm:gap-6">
              <dt class="text-sm font-bold text-ink">{f.label}</dt>
              <dd class="text-muted-foreground">{f.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="container-page py-20 sm:py-28">
    <div class="reveal flex flex-wrap justify-center gap-3">
      <a href={site.navCta.href} class="btn-base btn-brand px-9 py-4 text-base">
        {site.navCta.label}
      </a>
      <a href="/kontakt" class="btn-base btn-outline px-9 py-4 text-base">
        Kontakta oss
      </a>
    </div>
  </section>
</Base>
