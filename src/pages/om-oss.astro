---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import { site } from "../site.config";

const p = site.aboutPage;
---

<Base title={site.seo.about.title} description={site.seo.about.description}>
  <PageHero eyebrow={p.eyebrow} title={p.title} intro={p.intro} />

  <section class="mx-auto max-w-[60rem] px-5 py-16 sm:px-8 sm:py-24">
    <blockquote class="reveal border-l-4 border-signal pl-6 text-2xl leading-relaxed font-medium text-ink sm:text-3xl">
      “{p.quote}”
    </blockquote>
    <p class="reveal mt-8 text-lg leading-relaxed text-muted-foreground">{p.body}</p>
  </section>

  <section class="bg-steel py-16 sm:py-24">
    <div class="mx-auto grid max-w-[80rem] gap-4 px-5 sm:px-8 md:grid-cols-3">
      {p.values.map((v, i) => (
        <div class="reveal" style={`--d:${i * 80}ms`}>
          <article class="h-full rounded-xl bg-white p-8 shadow-sm ring-1 ring-line">
            <span class="grid size-14 place-items-center rounded-lg bg-brand text-white">
              <Icon name={v.icon} class="size-7" />
            </span>
            <h2 class="mt-6 text-4xl">{v.title}</h2>
            <p class="mt-3 leading-relaxed text-muted-foreground">{v.text}</p>
          </article>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-[80rem] px-5 py-16 sm:px-8 sm:py-24">
    <div class="reveal flex flex-wrap gap-3">
      <a href={site.navCta.href} class="btn-base btn-brand px-8">
        {site.navCta.label}
      </a>
      <a href="/samarbetspartners" class="btn-base btn-outline">
        Samarbetspartners
      </a>
    </div>
  </section>
</Base>
