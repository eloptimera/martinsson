---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Photo from "../components/Photo.astro";
import { site } from "../site.config";

const p = site.aboutPage;
---

<Base title={site.seo.about.title} description={site.seo.about.description}>
  <PageHero title={p.title} intro={p.intro} />

  <div class="container-page grid gap-12 py-12 sm:py-16 lg:grid-cols-[1.2fr_1fr] lg:gap-16">
    <div class="max-w-2xl">
      <blockquote class="border-l-4 border-brand pl-5 text-xl leading-relaxed">“{p.quote}”</blockquote>
      <p class="mt-6 text-muted-foreground">{p.body}</p>
      <dl class="mt-10 space-y-6">
        {p.facts.map((f) => (
          <div>
            <dt class="font-semibold">{f.title}</dt>
            <dd class="mt-1 text-muted-foreground">{f.text}</dd>
          </div>
        ))}
      </dl>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href={site.navCta.href} class="btn-base btn-brand">
          {site.navCta.label}
        </a>
        <a href="/samarbetspartners" class="btn-base btn-outline">
          Samarbetspartners
        </a>
      </div>
    </div>
    <div class="space-y-8">
      <Photo img={site.images.about} class="rounded" />
      {site.images.person && (
        <figure>
          <Photo img={site.images.person} class="aspect-[4/3] object-[55%_30%]" priority />
          <figcaption class="caps mt-3 text-ink">{site.person.name}</figcaption>
        </figure>
      )}
    </div>
  </div>
</Base>
