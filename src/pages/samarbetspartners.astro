---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../site.config";

const p = site.partnersPage;
---

<Base title={site.seo.partners.title} description={site.seo.partners.description}>
  <PageHero title={p.title} intro={p.intro} />

  <section class="container-page py-12 sm:py-16">
    <ul class="max-w-2xl divide-y divide-line border-y border-line">
      {p.partners.map((x) => (
        <li>
          <a
            href={x.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-baseline justify-between gap-4 py-4 hover:text-brand"
          >
            <span class="font-semibold">{x.name}</span>
            <span class="text-sm text-muted-foreground">
              {x.url.replace("https://", "")}
              <span class="sr-only"> (öppnas i ny flik)</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
