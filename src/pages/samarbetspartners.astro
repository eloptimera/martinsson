---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import { site } from "../site.config";

const p = site.partnersPage;
---

<Base title={site.seo.partners.title} description={site.seo.partners.description}>
  <PageHero eyebrow={p.eyebrow} title={p.title} intro={p.intro} />

  <section class="mx-auto max-w-[80rem] px-5 py-16 sm:px-8 sm:py-24">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {p.partners.map((x, i) => (
        <li class="reveal" style={`--d:${i * 60}ms`}>
          <a
            href={x.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex min-h-28 items-center justify-between gap-4 rounded-xl border-2 border-line bg-white p-6 transition duration-200 hover:-translate-y-1 hover:border-brand hover:shadow-lg hover:shadow-brand/15"
          >
            <span>
              <span class="block font-display text-3xl font-bold tracking-wide text-brand uppercase">
                {x.name}
              </span>
              <span class="mt-1 block text-sm text-muted-foreground">{x.url.replace("https://", "")}</span>
              <span class="sr-only"> (öppnas i ny flik)</span>
            </span>
            <span class="grid size-11 shrink-0 place-items-center rounded-full bg-steel text-brand transition-colors group-hover:bg-brand group-hover:text-white">
              <Icon name="arrowUpRight" />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
