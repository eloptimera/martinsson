---
import Base from "../layouts/Base.astro";
import PaintPanel from "../components/PaintPanel.astro";
import Icon from "../components/Icon.astro";
import { site } from "../site.config";
import { mark } from "../lib/text";

const c = site.company;
const h = site.home;
---

<Base title={site.seo.home.title} description={site.seo.home.description}>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden bg-steel">
    <div
      aria-hidden="true"
      class="absolute inset-y-0 right-0 -z-10 hidden w-[46%] skew-x-[-12deg] translate-x-24 bg-white lg:block"
    ></div>
    <div class="mx-auto grid max-w-[80rem] items-center gap-8 px-5 pt-12 pb-20 sm:px-8 lg:grid-cols-[1.05fr_0.95fr] lg:pt-16 lg:pb-28">
      <div>
        <p class="eyebrow">{h.eyebrow}</p>
        <h1
          class="mt-5 max-w-3xl text-[clamp(2.9rem,6.3vw,5.4rem)] leading-[1.06]"
          set:html={mark(h.headline)}
        />
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground">{h.text}</p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={site.navCta.href} class="btn-base btn-brand px-8">
            {h.cta}
          </a>
          <a href="/tjanster" class="btn-base btn-outline">
            {h.ctaSecondary}
          </a>
        </div>
        <a
          href={`tel:${c.phoneLink}`}
          class="mt-7 inline-flex min-h-11 items-center gap-3 font-display text-3xl font-bold tracking-wide text-brand hover:text-brand-deep"
        >
          <span class="grid size-11 place-items-center rounded-full bg-brand text-white">
            <Icon name="phone" class="size-5" />
          </span>
          {c.phone}
        </a>
      </div>
      <div class="relative">
        <PaintPanel class="mx-auto w-full max-w-[44rem] lg:scale-110" />
        <p class="absolute top-2 right-0 hidden rotate-[4deg] bg-signal px-4 py-2 font-display text-xl font-bold tracking-wider text-ink uppercase sm:block">
          {h.badge}
        </p>
      </div>
    </div>
  </section>

  <!-- Snabbinfo -->
  <section class="relative z-10 px-5 sm:px-8">
    <div class="mx-auto -mt-8 grid max-w-[80rem] gap-4 lg:grid-cols-3">
      <div class="rounded-xl bg-brand p-7 text-white shadow-lg shadow-brand/20">
        <p class="flex items-center gap-3 font-display text-2xl font-bold tracking-wider uppercase">
          <Icon name="spray" class="size-7" />
          {h.quickServices}
        </p>
        <ul class="mt-4 space-y-1.5 text-white/90">
          {site.services.map((t) => (
            <li>
              <a
                href={`/tjanster#${t.id}`}
                class="inline-flex min-h-8 items-center gap-2 underline decoration-white/30 underline-offset-4 hover:decoration-signal"
              >
                <Icon name="check" class="size-4 text-signal" strokeWidth={3} />
                {t.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="rounded-xl bg-brand p-7 text-white shadow-lg shadow-brand/20">
        <p class="flex items-center gap-3 font-display text-2xl font-bold tracking-wider uppercase">
          <Icon name="clock" class="size-7" />
          {h.quickHours}
        </p>
        <dl class="mt-4 space-y-1.5 text-white/90">
          {c.hours.map((o) => (
            <div class="flex justify-between gap-4 border-b border-white/15 pb-1.5 last:border-0">
              <dt>{o.days}</dt>
              <dd class="font-bold tabular-nums">{o.time}</dd>
            </div>
          ))}
        </dl>
        <p data-open-status class="mt-4 inline-flex items-center gap-2 text-sm font-bold" hidden></p>
      </div>
      <div class="rounded-xl bg-brand p-7 text-white shadow-lg shadow-brand/20">
        <p class="flex items-center gap-3 font-display text-2xl font-bold tracking-wider uppercase">
          <Icon name="phone" class="size-7" />
          {h.quickContact}
        </p>
        <a
          href={`tel:${c.phoneLink}`}
          class="mt-4 block font-display text-4xl font-bold tracking-wide hover:text-signal"
        >
          {c.phone}
        </a>
        <a
          href={`mailto:${c.email}`}
          class="mt-2 inline-block break-all text-white/90 underline decoration-white/30 underline-offset-4 hover:decoration-signal"
        >
          {c.email}
        </a>
        <a href={site.navCta.href} class="btn-base btn-white mt-5 w-full">
          {site.navCta.label}
        </a>
      </div>
    </div>
  </section>

  <!-- Tjänster -->
  <section id="tjanster" class="mx-auto max-w-[80rem] px-5 py-20 sm:px-8 sm:py-28">
    <div class="reveal max-w-2xl">
      <p class="eyebrow">{h.servicesEyebrow}</p>
      <h2 class="mt-4 text-5xl sm:text-6xl" set:html={mark(h.servicesHeading)} />
    </div>
    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {site.services.map((t, i) => (
        <div class="reveal" style={`--d:${i * 70}ms`}>
          <a
            href={`/tjanster#${t.id}`}
            class="group relative flex h-full min-h-[19rem] flex-col overflow-hidden rounded-xl border-2 border-line bg-white p-7 transition duration-300 hover:-translate-y-1 hover:border-brand hover:shadow-xl hover:shadow-brand/15"
          >
            <span class="absolute inset-x-0 top-0 h-1.5 bg-brand transition-colors group-hover:bg-signal"></span>
            <span class="grid size-14 place-items-center rounded-lg bg-steel text-brand transition-colors group-hover:bg-brand group-hover:text-white">
              <Icon name={t.icon} class="size-7" />
            </span>
            <h3 class="mt-6 text-3xl xl:text-4xl">{t.title}</h3>
            <p class="mt-3 flex-1 leading-relaxed text-muted-foreground">{t.short}</p>
            <span class="mt-5 inline-flex items-center gap-2 font-display text-lg font-bold tracking-wider text-brand uppercase">
              Läs mer <Icon name="arrowUpRight" class="size-4" />
            </span>
          </a>
        </div>
      ))}
    </div>
  </section>

  <!-- Kunder -->
  <section class="bg-steel py-20 sm:py-24">
    <div class="mx-auto max-w-[80rem] px-5 sm:px-8">
      <div class="reveal max-w-3xl">
        <p class="eyebrow">{h.customersEyebrow}</p>
        <h2 class="mt-4 text-5xl sm:text-6xl" set:html={mark(h.customersHeading)} />
      </div>
      <div class="mt-10 grid gap-4 md:grid-cols-3">
        {h.customers.map((k, i) => (
          <div class="reveal" style={`--d:${i * 80}ms`}>
            <article class="h-full rounded-xl bg-white p-7 shadow-sm ring-1 ring-line">
              <span class="grid size-12 place-items-center rounded-lg bg-brand text-white">
                <Icon name={k.icon} class="size-6" />
              </span>
              <h3 class="mt-5 text-3xl">{k.title}</h3>
              <p class="mt-2 leading-relaxed text-muted-foreground">{k.text}</p>
            </article>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Om oss -->
  <section class="panel-brand relative isolate overflow-hidden">
    <div aria-hidden="true" class="stripes absolute inset-0 -z-10"></div>
    <div class="reveal mx-auto grid max-w-[80rem] gap-8 px-5 py-20 sm:px-8 sm:py-28 lg:grid-cols-[0.8fr_1.2fr] lg:items-center lg:gap-16">
      <div>
        <p class="font-display text-base font-bold tracking-[0.18em] text-white/85 uppercase before:mr-3 before:inline-block before:h-[3px] before:w-6 before:bg-signal before:align-middle">
          {h.aboutEyebrow}
        </p>
        <h2 class="mt-4 text-5xl sm:text-7xl">{h.aboutHeading}</h2>
        <a href="/om-oss" class="btn-base btn-white mt-8">
          {h.aboutLink}
        </a>
      </div>
      <blockquote class="border-l-4 border-signal pl-6 font-sans text-xl leading-relaxed font-medium sm:text-2xl">
        “{h.aboutQuote}”
      </blockquote>
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-[80rem] px-5 py-20 sm:px-8 sm:py-24">
    <div class="reveal flex flex-col items-start justify-between gap-8 rounded-xl border-2 border-brand p-8 sm:p-12 lg:flex-row lg:items-center">
      <div>
        <p class="eyebrow">{h.ctaEyebrow}</p>
        <h2 class="mt-4 max-w-2xl text-5xl sm:text-6xl" set:html={mark(h.ctaHeading)} />
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={site.navCta.href} class="btn-base btn-brand px-8">
          {site.navCta.label}
        </a>
        <a href={`tel:${c.phoneLink}`} class="btn-base btn-outline">
          <Icon name="phone" class="size-5" />
          {c.phone}
        </a>
      </div>
    </div>
  </section>
</Base>
