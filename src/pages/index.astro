---
import Base from "../layouts/Base.astro";
import GardenIsland from "../components/GardenIsland.astro";
import Icon from "../components/Icon.astro";
import { site } from "../site.config";
import { mark } from "../lib/text";

const c = site.company;
const h = site.home;
---

<Base title={site.seo.home.title} description={site.seo.home.description} white>
  <!-- Hero (i kortet) -->
  <div slot="hero" class="relative overflow-hidden">
    <div class="grid items-center gap-6 px-6 pt-2 pb-12 sm:px-10 lg:grid-cols-[0.95fr_1.05fr] lg:gap-4 lg:pt-4 lg:pb-16">
      <div class="relative z-10">
        <h1 class="max-w-2xl text-[clamp(2.9rem,5.2vw,4.8rem)] leading-[1.03]" set:html={mark(h.headline)} />
        <p class="mt-6 max-w-md text-lg leading-relaxed text-muted-foreground">{h.text}</p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={site.navCta.href} class="btn-base btn-brand px-7">
            <Icon name="leaf" class="size-5" />
            {h.cta}
          </a>
          <a href="/tjanster" class="btn-base btn-outline">
            {h.ctaSecondary}
          </a>
        </div>
      </div>

      <div class="relative">
        <GardenIsland class="mx-auto w-full max-w-[40rem] lg:mt-2 lg:max-w-none lg:-translate-x-3 lg:scale-[1.06]" />
      </div>
    </div>
  </div>

  <!-- Tjänster -->
  <section id="tjanster" class="container-page py-16 sm:py-24">
    <div class="reveal max-w-2xl">
      <p class="eyebrow">{h.servicesEyebrow}</p>
      <h2 class="mt-4 text-5xl sm:text-6xl" set:html={mark(h.servicesHeading)} />
      <p class="mt-5 text-lg leading-relaxed text-muted-foreground">{h.servicesIntro}</p>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {site.services.map((t, i) => (
        <div class="reveal" style={`--d:${i * 70}ms`}>
          <a
            href={`/tjanster#${t.id}`}
            class="group flex h-full min-h-[17rem] flex-col rounded-[1.75rem] bg-white p-7 shadow-md shadow-brand/10 ring-1 ring-line transition duration-300 hover:-translate-y-1 hover:shadow-xl"
          >
            <span class="grid size-14 place-items-center rounded-2xl bg-tint text-leaf transition-colors group-hover:bg-brand group-hover:text-white">
              <Icon name={t.icon} class="size-7" />
            </span>
            <h3 class="mt-6 text-3xl">{t.title}</h3>
            <p class="mt-3 flex-1 leading-relaxed text-muted-foreground">{t.short}</p>
            <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-leaf">
              Läs mer <Icon name="arrowUpRight" class="size-4" />
            </span>
          </a>
        </div>
      ))}
    </div>
  </section>

  <!-- RUT -->
  <section class="px-3 sm:px-6">
    <div class="reveal">
      <div class="panel-forest mx-auto grid max-w-[88rem] gap-10 overflow-hidden rounded-[2rem] px-6 py-14 sm:px-14 sm:py-20 lg:grid-cols-[1.3fr_0.7fr] lg:items-center">
        <div>
          <p class="eyebrow !text-lime">{h.rutEyebrow}</p>
          <h2 class="mt-4 max-w-xl text-5xl sm:text-6xl [&_em]:!text-lime" set:html={mark(h.rutHeading)} />
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/85">{h.rutText}</p>
          <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
            {h.rutPoints.map((p) => (
              <li class="flex items-center gap-2 text-sm font-bold text-white">
                <Icon name="check" class="size-4 text-lime" strokeWidth={3} />
                {p}
              </li>
            ))}
          </ul>
          <p class="mt-6 max-w-xl text-xs leading-relaxed text-white/65">{h.rutNote}</p>
          <a href={site.navCta.href} class="btn-base btn-white mt-8">
            {site.navCta.label}
          </a>
        </div>
        <div class="text-center lg:text-right">
          <p
            aria-hidden="true"
            class="font-display text-[clamp(6rem,16vw,11rem)] leading-none font-medium text-lime"
          >
            50 %
          </p>
          <p class="mt-2 text-sm font-bold tracking-[0.14em] text-white/80 uppercase">
            avdrag på arbetskostnaden
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Om oss -->
  <section class="container-page grid gap-12 py-20 sm:py-28 lg:grid-cols-[1.2fr_0.8fr] lg:items-center lg:gap-16">
    <div class="reveal">
      <p class="eyebrow">{h.aboutEyebrow}</p>
      <h2 class="mt-4 max-w-2xl text-5xl sm:text-6xl" set:html={mark(h.aboutHeading)} />
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground">{h.aboutText}</p>
      <ul class="mt-6 flex flex-wrap gap-2">
        {h.audiences.map((a) => (
          <li class="rounded-full bg-tint px-4 py-2 text-sm font-bold text-brand-deep">{a}</li>
        ))}
      </ul>
      <a href="/om-oss" class="btn-base btn-outline mt-8">
        {h.aboutLink}
      </a>
    </div>
    <div class="reveal" style="--d:120ms">
      <dl class="grid grid-cols-2 gap-4">
        <div class="rounded-[1.75rem] bg-brand p-6 text-white">
          <dt class="text-xs font-bold tracking-[0.14em] text-white/85 uppercase">Verksamma sedan</dt>
          <dd class="mt-3 font-display text-4xl sm:text-5xl">{c.founded}</dd>
        </div>
        <div class="rounded-[1.75rem] bg-brand-deep p-6 text-white">
          <dt class="text-xs font-bold tracking-[0.14em] text-lime uppercase">Bas</dt>
          <dd class="mt-3 font-display text-2xl sm:text-4xl">{c.postalCity}</dd>
        </div>
        <div class="col-span-2 rounded-[1.75rem] bg-tint p-6">
          <dt class="text-xs font-bold tracking-[0.14em] text-leaf uppercase">Verksamhetsområde</dt>
          <dd class="mt-3 font-display text-3xl text-ink">{c.area}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Avslutande CTA -->
  <section class="px-3 pb-3 sm:px-6">
    <div class="reveal">
      <div class="panel-green relative mx-auto max-w-[88rem] overflow-hidden rounded-[2rem] px-6 py-16 text-white sm:px-14 sm:py-24">
        <svg
          aria-hidden="true"
          viewBox="0 0 400 400"
          class="pointer-events-none absolute top-1/2 -right-10 hidden h-[26rem] -translate-y-1/2 text-white/15 lg:block"
          fill="currentColor"
        >
          <path d="M60 340C60 170 170 60 340 60c0 170-110 280-280 280Z"></path>
          <path
            d="M60 340 230 170"
            stroke="#fff"
            stroke-opacity="0.35"
            stroke-width="6"
            stroke-linecap="round"
            fill="none"
          ></path>
          <path d="M20 250c0-80 50-130 130-130 0 80-50 130-130 130Z" opacity="0.7"></path>
        </svg>
        <p class="text-xs font-bold tracking-[0.16em] text-white/85 uppercase">{h.ctaEyebrow}</p>
        <h2
          class="mt-5 max-w-2xl text-[clamp(2.8rem,5.6vw,4.6rem)] leading-[1.05] [&_em]:!text-white"
          set:html={mark(h.ctaHeading)}
        />
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={site.navCta.href} class="btn-base btn-white">
            {site.navCta.label}
          </a>
          <a href="/tjanster" class="btn-base btn-outline-white">
            Våra tjänster
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
