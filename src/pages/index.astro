---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { site } from "../site.config";
import { mark } from "../lib/text";

const c = site.company;
const h = site.home;
---

<Base title={site.seo.home.title} description={site.seo.home.description}>
  <!-- Hero: karossen i grundvitt, halvt lackerad i blått -->
  <section class="relative isolate overflow-hidden">
    <div class="mx-auto max-w-[88rem] px-5 pt-2 pb-10 sm:px-10">
      <div class="caps flex items-start justify-between gap-6 text-ink">
        <span class="hidden sm:inline">Lackering · Rostskydd · Plastreparationer</span>
        <span>Över 60 års erfarenhet</span>
      </div>

      <div class="relative mt-6 sm:mt-10">
        <!-- Ordbild med hårfina linjer -->
        <div aria-hidden="true" class="relative -mx-5 border-y border-ink/60 py-2 sm:-mx-10">
          <p class="text-center font-[family-name:var(--font-serif)] text-[clamp(3.4rem,15.5vw,15.5rem)] leading-[0.92] font-medium tracking-[-0.02em] text-ink uppercase select-none">
            Lackering
          </p>
        </div>
        <span
          aria-hidden="true"
          class="pointer-events-none absolute top-[66%] left-1/2 hidden aspect-[2.6/1] w-[min(70%,62rem)] -translate-x-1/2 -translate-y-1/2 rounded-[50%] border border-ink/60 lg:block"
        ></span>

        <!-- Karossen -->
        <figure
          class="relative z-10 mx-auto -mt-[7vw] w-[min(94%,72rem)] sm:-mt-[6.5vw]"
          style="--car-mask:url('/hero-car.webp')"
        >
          <div class="relative aspect-[1091/348]">
            <!-- Golvskugga -->
            <div
              aria-hidden="true"
              class="absolute inset-x-[8%] -bottom-[14%] h-[16%] rounded-[50%] bg-ink/25 blur-2xl"
            ></div>
            <img
              src="/hero-car.webp"
              width="1091"
              height="348"
              alt="Bilkaross i grundvitt som är halvt lackerad i blått"
              fetchpriority="high"
              decoding="async"
              class="absolute inset-0 size-full select-none"
            />
            <!-- Blått lack: multiplicerar karossens skuggning -->
            <div
              class="paint-layer mix-blend-multiply"
              style="background:linear-gradient(165deg,#4562e8 0%,#2a41ae 50%,#1b2a85 100%)"
            ></div>
            <!-- Fördjupar skuggor och veck i det lackerade -->
            <div
              class="paint-layer opacity-80 mix-blend-multiply"
              style="background:url('/hero-car.webp') center/100% 100% no-repeat"
            ></div>
            <!-- Glans -->
            <div
              class="paint-layer opacity-60 mix-blend-screen"
              style="background:radial-gradient(55% 60% at 26% 28%,rgba(255,255,255,.6),transparent 70%),linear-gradient(100deg,transparent 38%,rgba(255,255,255,.3) 50%,transparent 62%)"
            ></div>
            <!-- Den blå skiljelinjen -->
            <svg
              viewBox="0 0 1091 348"
              aria-hidden="true"
              class="pointer-events-none absolute inset-0 size-full overflow-visible"
            >
              <line x1="768" y1="-60" x2="372" y2="372" stroke="#243a96" stroke-width="2.5"></line>
            </svg>
          </div>
        </figure>
      </div>

      <div class="mt-10 grid items-end gap-8 sm:mt-16 lg:grid-cols-[1.25fr_1fr] lg:gap-16">
        <h1 class="max-w-3xl text-4xl leading-[1.08] sm:text-5xl lg:text-6xl">
          Lackering som <em class="text-brand">håller</em>
        </h1>
        <div>
          <p class="max-w-md text-[1.0625rem] text-ink/80">{h.text}</p>
          <div class="mt-6 flex flex-wrap items-center gap-3">
            <a href={site.navCta.href} class="btn-base btn-brand">
              {h.cta}
            </a>
            <a href={`tel:${c.phoneLink}`} class="btn-base btn-outline">
              <Icon name="phone" class="size-4" />
              {c.phone}
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Kontaktrad -->
    <div class="border-y border-ink/20">
      <dl class="mx-auto grid max-w-[88rem] gap-0 px-5 sm:grid-cols-3 sm:px-10">
        <div class="py-5 sm:pr-8">
          <dt class="caps text-muted-foreground">Telefon</dt>
          <dd class="mt-1">
            <a
              href={`tel:${c.phoneLink}`}
              class="font-[family-name:var(--font-serif)] text-3xl hover:text-brand"
            >
              {c.phone}
            </a>
          </dd>
        </div>
        <div class="border-t border-ink/20 py-5 sm:border-t-0 sm:border-l sm:px-8">
          <dt class="caps text-muted-foreground">E-post</dt>
          <dd class="mt-1">
            <a
              href={`mailto:${c.email}`}
              class="break-all underline decoration-ink/30 underline-offset-4 hover:decoration-brand"
            >
              {c.email}
            </a>
          </dd>
        </div>
        <div class="border-t border-ink/20 py-5 sm:border-t-0 sm:border-l sm:pl-8">
          <dt class="caps text-muted-foreground">Öppettider</dt>
          <dd class="mt-1">
            Mån–tors 07–17 · Fre 07–13{" "}
            <span data-open-status class="mt-1 flex items-center gap-2 text-sm font-semibold" hidden></span>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Tjänster -->
  <section class="container-page py-16 sm:py-20">
    <h2 class="text-3xl sm:text-4xl">{h.servicesHeading}</h2>
    <ul class="mt-8 divide-y divide-line border-y border-line">
      {site.services.map((t) => (
        <li>
          <a
            href={`/${t.id}`}
            class="group grid gap-1 py-6 sm:grid-cols-[14rem_1fr_auto] sm:items-baseline sm:gap-8"
          >
            <span class="text-xl font-semibold text-brand group-hover:underline">{t.title}</span>
            <span class="text-muted-foreground">{t.short}</span>
            <span class="hidden items-center gap-1 text-sm font-semibold text-brand sm:inline-flex">
              Läs mer <Icon name="arrow" class="size-4" />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Kunder + om oss -->
  <section class="border-t border-line bg-tint">
    <div class="container-page grid gap-12 py-16 sm:py-20 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="text-3xl sm:text-4xl">{h.customersHeading}</h2>
        <p class="mt-4 text-muted-foreground">{h.customersText}</p>
        <ul class="mt-5 space-y-2 font-medium">
          <li class="flex gap-3">
            <Icon name="check" class="mt-1 size-4 shrink-0 text-brand" strokeWidth={3} />
            Privatpersoner
          </li>
          <li class="flex gap-3">
            <Icon name="check" class="mt-1 size-4 shrink-0 text-brand" strokeWidth={3} />
            Försäkringsbolag
          </li>
          <li class="flex gap-3">
            <Icon name="check" class="mt-1 size-4 shrink-0 text-brand" strokeWidth={3} />
            Företag
          </li>
        </ul>
      </div>
      <div>
        <h2 class="text-3xl sm:text-4xl">{h.aboutHeading}</h2>
        <blockquote class="mt-4 border-l-4 border-brand pl-5 text-lg">“{h.aboutQuote}”</blockquote>
        <a
          href="/om-oss"
          class="mt-5 inline-flex items-center gap-1 font-semibold text-brand hover:underline"
        >
          {h.aboutLink} <Icon name="arrow" class="size-4" />
        </a>
      </div>
    </div>
  </section>

  <!-- Offert -->
  <section class="container-page py-14 sm:py-16">
    <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
      <h2 class="text-2xl sm:text-3xl">{h.ctaHeading}</h2>
      <div class="flex flex-wrap gap-3">
        <a href={site.navCta.href} class="btn-base btn-brand">
          {site.navCta.label}
        </a>
        <a href={`tel:${c.phoneLink}`} class="btn-base btn-outline">
          {c.phone}
        </a>
      </div>
    </div>
  </section>
</Base>
