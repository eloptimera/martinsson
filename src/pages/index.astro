---
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import Icon from "../components/Icon.astro";
import { site } from "../site.config";
import { mark } from "../lib/text";

const c = site.company;
const h = site.home;
---

<Base title={site.seo.home.title} description={site.seo.home.description}>
  <!-- Hero -->
  <section class="bg-brand text-white">
    <div class="container-page grid gap-10 py-14 sm:py-20 lg:grid-cols-[1.3fr_1fr] lg:items-start lg:gap-16">
      <div>
        <h1 class="max-w-2xl text-4xl sm:text-5xl lg:text-6xl" set:html={mark(h.headline)} />
        <p class="mt-5 max-w-xl text-lg text-white/90">{h.text}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={site.navCta.href} class="btn-base btn-white">
            {h.cta}
          </a>
          <a href="/tjanster" class="btn-base btn-outline-white">
            Våra tjänster
          </a>
        </div>
      </div>

      <aside aria-label="Kontakt och öppettider" class="rounded-md bg-white p-6 text-ink sm:p-7">
        <p class="text-sm font-semibold text-muted-foreground">Ring oss</p>
        <a
          href={`tel:${c.phoneLink}`}
          class="block text-4xl font-bold tracking-tight text-brand hover:text-brand-deep"
        >
          {c.phone}
        </a>
        <a href={`mailto:${c.email}`} class="mt-1 inline-block text-[0.95rem] break-all text-ink underline">
          {c.email}
        </a>

        <h2 class="mt-6 text-base font-semibold">Öppettider</h2>
        <dl class="mt-2 text-[0.95rem]">
          {c.hours.map((o) => (
            <div class="flex justify-between gap-4 border-b border-line py-1.5 last:border-0">
              <dt>{o.days}</dt>
              <dd class="tabular-nums text-muted-foreground">{o.time}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-2 text-sm text-muted-foreground">{c.hoursNote}</p>
        <p data-open-status class="mt-3 inline-flex items-center gap-2 text-sm font-semibold" hidden></p>
      </aside>
    </div>
  </section>

  <Photo img={site.images.hero} priority class="max-h-[28rem]" />

  <!-- Tjänster -->
  <section class="container-page py-16 sm:py-20">
    <h2 class="text-3xl sm:text-4xl">{h.servicesHeading}</h2>
    <ul class="mt-8 divide-y divide-line border-y border-line">
      {site.services.map((t) => (
        <li>
          <a
            href={`/${t.id}`}
            class="group grid gap-1 py-6 sm:grid-cols-[14rem_1fr_auto] sm:items-baseline sm:gap-8"
          >
            <span class="text-xl font-semibold text-brand group-hover:underline">{t.title}</span>
            <span class="text-muted-foreground">{t.short}</span>
            <span class="hidden items-center gap-1 text-sm font-semibold text-brand sm:inline-flex">
              Läs mer <Icon name="arrow" class="size-4" />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Kunder + om oss -->
  <section class="border-t border-line bg-tint">
    <div class="container-page grid gap-12 py-16 sm:py-20 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="text-3xl sm:text-4xl">{h.customersHeading}</h2>
        <p class="mt-4 text-muted-foreground">{h.customersText}</p>
        <ul class="mt-5 space-y-2 font-medium">
          <li class="flex gap-3">
            <Icon name="check" class="mt-1 size-4 shrink-0 text-brand" strokeWidth={3} />
            Privatpersoner
          </li>
          <li class="flex gap-3">
            <Icon name="check" class="mt-1 size-4 shrink-0 text-brand" strokeWidth={3} />
            Försäkringsbolag
          </li>
          <li class="flex gap-3">
            <Icon name="check" class="mt-1 size-4 shrink-0 text-brand" strokeWidth={3} />
            Företag
          </li>
        </ul>
      </div>
      <div>
        <h2 class="text-3xl sm:text-4xl">{h.aboutHeading}</h2>
        <blockquote class="mt-4 border-l-4 border-brand pl-5 text-lg">“{h.aboutQuote}”</blockquote>
        <a
          href="/om-oss"
          class="mt-5 inline-flex items-center gap-1 font-semibold text-brand hover:underline"
        >
          {h.aboutLink} <Icon name="arrow" class="size-4" />
        </a>
      </div>
    </div>
  </section>

  <!-- Offert -->
  <section class="container-page py-14 sm:py-16">
    <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
      <h2 class="text-2xl sm:text-3xl">{h.ctaHeading}</h2>
      <div class="flex flex-wrap gap-3">
        <a href={site.navCta.href} class="btn-base btn-brand">
          {site.navCta.label}
        </a>
        <a href={`tel:${c.phoneLink}`} class="btn-base btn-outline">
          {c.phone}
        </a>
      </div>
    </div>
  </section>
</Base>
